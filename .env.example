# ═══════════════════════════════════════════════════════════════════
#  Governed Audit Log — Environment Configuration
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
# SQLite for local dev (default):
DATABASE_URL=sqlite:///./audit_log.db

# PostgreSQL for production (Docker / AWS RDS):
# DATABASE_URL=postgresql://audit_user:audit_pass@localhost:5432/governed_audit_db

# ── PII Encryption ────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=gK4P1Xz8Z9R7W2Y6A3B5C8D1E4F7G0H3I6J9K2L5M8N=

# ── JWT Configuration ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRE_HOURS=24

# ── API Keys (X-API-Key header) ───────────────────────────────────
ADMIN_API_KEY=admin-secret-key-123
AUDITOR_API_KEY=auditor-secret-key-456
SERVICE_API_KEY=service-secret-key-789

# ── Default Admin User ────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@governed.ai

# ── LLM Providers ─────────────────────────────────────────────────
# Priority: Groq → OpenAI → mock fallback

# 1. GROQ (FREE — recommended for testing & development)
#    Sign up at https://console.groq.com → API Keys
#    Key format: gsk_...
GROQ_API_KEY=gsk_your_groq_key_here

# 2. OpenAI (paid — recommended for production/submission demos)
#    Sign up at https://platform.openai.com/api-keys
#    Key format: sk-...
OPENAI_API_KEY=sk-your-openai-key-here

# Force a specific provider (optional): "groq" | "openai" | "mock"
# LLM_PROVIDER=groq
